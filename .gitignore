# Local credentials — copy from config.template.h and fill in
main/config.h

# IDF build artifacts
build/
sdkconfig
sdkconfig.old

# IDF managed components — fetched from registry per dependencies.lock
managed_components/

# Local debug screenshots
IMG_*.jpg

# Python bytecode cache (image generators)
__pycache__/
*.pyc

# Secure-build secrets — NEVER commit. The flash-encryption key (host-generated
# for pre-encryption) and any Secure Boot signing key must be stored offline.
*flash_encryption_key*.bin
*secure_boot_signing_key*.pem
*.key
secure_keys/
